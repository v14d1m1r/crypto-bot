# PowerShell does not load this file automatically; see README.md.
BOT_MODE=paper
BOT_SYMBOL=BTCUSDT
BOT_INTERVAL=1m
BOT_FAST_EMA=20
BOT_SLOW_EMA=50
BOT_STARTING_CASH=10000
BOT_POSITION_FRACTION=0.25
BOT_FEE_RATE=0.001
BOT_STOP_LOSS=0.02
BOT_TAKE_PROFIT=0.04
BOT_MAX_ORDER_QUOTE=25
BOT_MAX_DAILY_LOSS_QUOTE=10
BOT_MAX_ENTRIES_PER_DAY=10
BOT_MAX_CONSECUTIVE_LOSSES=3
# Defaults to three candle intervals plus 30 seconds when unset.
# BOT_STALE_DATA_SECONDS=210
BOT_BACKTEST_LIMIT=500
# DATABASE_URL=sqlite://crypto_bot.db?mode=rwc
# TESTNET_DATABASE_URL=sqlite://crypto_bot_testnet.db?mode=rwc
BOT_API_ADDRESS=127.0.0.1:3001
BOT_CORS_ORIGIN=http://localhost:3000

# Optional endpoint overrides:
# BINANCE_REST_BASE=https://api.binance.com
# BINANCE_WS_BASE=wss://stream.binance.com:9443/ws

# Binance Spot Testnet only. Never put production credentials here.
# Create these at https://testnet.binance.vision/ and set them in your shell.
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_SECRET_KEY=
# BINANCE_TESTNET_REST_BASE=https://testnet.binance.vision
# BINANCE_TESTNET_WS_BASE=wss://stream.testnet.binance.vision/ws
# BINANCE_TESTNET_WS_API_BASE=wss://ws-api.testnet.binance.vision/ws-api/v3

# Optional Telegram operational alerts. Keep the bot token secret.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
