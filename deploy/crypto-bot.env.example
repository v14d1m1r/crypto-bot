# This file is read by systemd. Install it as /etc/crypto-bot/crypto-bot.env
# owned by root:crypto-bot with mode 0640. Never commit populated secrets.
BOT_MODE=testnet
BOT_SYMBOL=BTCUSDT
BOT_INTERVAL=1m
BOT_FAST_EMA=20
BOT_SLOW_EMA=50
BOT_POSITION_FRACTION=0.25
BOT_STOP_LOSS=0.02
BOT_TAKE_PROFIT=0.04
BOT_MAX_ORDER_QUOTE=25
BOT_MAX_DAILY_LOSS_QUOTE=10
BOT_MAX_ENTRIES_PER_DAY=10
BOT_MAX_CONSECUTIVE_LOSSES=3
BOT_STALE_DATA_SECONDS=210
BOT_API_ADDRESS=127.0.0.1:3001
BOT_CORS_ORIGIN=http://localhost:3000
TESTNET_DATABASE_URL=sqlite:///var/lib/crypto-bot/crypto_bot_testnet.db?mode=rwc

BINANCE_TESTNET_API_KEY=replace-on-server
BINANCE_TESTNET_SECRET_KEY=replace-on-server
TELEGRAM_BOT_TOKEN=replace-on-server
TELEGRAM_CHAT_ID=replace-on-server
