[Unit]
Description=Back up CRUX Testnet SQLite database
ConditionPathExists=/var/lib/crypto-bot/crypto_bot_testnet.db

[Service]
Type=oneshot
User=crypto-bot
Group=crypto-bot
Environment=CRYPTO_BOT_DB_PATH=/var/lib/crypto-bot/crypto_bot_testnet.db
Environment=CRYPTO_BOT_BACKUP_DIR=/var/backups/crypto-bot
ExecStart=/opt/crypto-bot/bin/backup-sqlite.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/crypto-bot
